# =============================================================================
# KLTN Blockchain environment template
#
# Blockchain owns deploy/governance config only.
# Backend runtime config belongs in ../backend/.env.
# Frontend public wallet config belongs in ../frontend/.env.
#
# Copy inside this folder:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Deploy RPC
# -----------------------------------------------------------------------------
# Used by Hardhat deploy scripts only.
NETWORK_RPC_URL=https://your-production-rpc.example

# -----------------------------------------------------------------------------
# Deployer
# -----------------------------------------------------------------------------
# Used by `npm run deploy:custom`.
# Can equal owner key if owner deploys, but production should prefer a controlled
# deploy machine/CI secret and a multisig/cold owner.
PRIVATE_KEY=0xDEPLOYER_PRIVATE_KEY_ONLY_FOR_DEPLOY

# -----------------------------------------------------------------------------
# Owner/root governance
# -----------------------------------------------------------------------------
# Owner can authorize/revoke Admin wallets, add/remove relayers, and transfer
# ownership. Production should use a cold wallet or multisig.
BLOCKCHAIN_OWNER_ADDRESS=0xCOLD_WALLET_OR_MULTISIG
BLOCKCHAIN_OWNER_PRIVATE_KEY=0xOWNER_PRIVATE_KEY_FOR_DEPLOY_OR_LOCAL_ONLY

# -----------------------------------------------------------------------------
# Backend relayer address
# -----------------------------------------------------------------------------
# Only the address belongs here so deploy.js can authorize it.
# The relayer private key belongs in ../backend/.env.
BLOCKCHAIN_RELAYER_ADDRESS=0xBACKEND_RELAYER_ADDRESS

# Deprecated compatibility fallback. Prefer explicit owner/deployer config.
# SUPER_ADMIN_PRIVATE_KEY=
