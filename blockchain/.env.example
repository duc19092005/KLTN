# =============================================================================
# KLTN Blockchain environment template
#
# Copy inside this folder:
#   cp .env.example .env
#
# IMPORTANT:
# - The active values below are LOCAL HARDHAT defaults only.
# - Production values are in the commented template near the bottom.
# - Root ../.env intentionally does not contain blockchain keys anymore.
# =============================================================================

# =============================================================================
# CASE 1: LOCAL DEVELOPMENT - Hardhat localhost, chainId 31337
# =============================================================================

# -----------------------------------------------------------------------------
# Local RPC
# -----------------------------------------------------------------------------
# NETWORK_RPC_URL is used by Hardhat deploy scripts.
# BLOCKCHAIN_RPC_URL is used by the backend runtime when it runs natively.
# Docker Compose overrides backend BLOCKCHAIN_RPC_URL to:
#   http://host.docker.internal:8545
NETWORK_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# -----------------------------------------------------------------------------
# Local deployer
# -----------------------------------------------------------------------------
# PRIVATE_KEY is used only by `npm run deploy:custom`.
# `npm run deploy:local` uses Hardhat localhost signers directly.
# Local default below is Hardhat account #0. Do not use outside local dev.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# -----------------------------------------------------------------------------
# Local contract addresses
# -----------------------------------------------------------------------------
# These are deterministic only for a fresh Hardhat node after scripts/deploy.js.
# If you restart/reset Hardhat, deploy again and update these values.
IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
FACE_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
AUDIT_ANCHOR_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# -----------------------------------------------------------------------------
# Local owner/root governance - Hardhat account #0
# -----------------------------------------------------------------------------
# Owner can authorize/revoke Admin wallets, add/remove relayers, and transfer
# ownership. Keeping the owner key here is acceptable only for local dev.
BLOCKCHAIN_OWNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
BLOCKCHAIN_OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# -----------------------------------------------------------------------------
# Local backend relayer - Hardhat account #1
# -----------------------------------------------------------------------------
# Relayer signs routine backend writes such as AuditAnchor.commitRoot() and
# FaceRegistry hashes. Owner can revoke and replace it.
BLOCKCHAIN_RELAYER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
BLOCKCHAIN_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Deprecated compatibility fallback. Prefer explicit owner/relayer keys.
# SUPER_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Local frontend wallet verification config
# -----------------------------------------------------------------------------
# Hardhat local chain ID is 31337.
VITE_IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_NETWORK_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337

# =============================================================================
# CASE 2: PRODUCTION / REAL NETWORK TEMPLATE
# =============================================================================
#
# Do NOT uncomment this block blindly. Copy the names into your production
# secret manager or production blockchain/.env and replace every placeholder.
#
# Required production values:
#
# NETWORK_RPC_URL=https://your-production-rpc.example
# BLOCKCHAIN_RPC_URL=https://your-production-rpc.example
#
# PRIVATE_KEY=0xDEPLOYER_PRIVATE_KEY_ONLY_FOR_DEPLOY
#
# IDENTITY_REGISTRY_ADDRESS=0xDEPLOYED_IDENTITY_REGISTRY
# FACE_REGISTRY_ADDRESS=0xDEPLOYED_FACE_REGISTRY
# AUDIT_ANCHOR_ADDRESS=0xDEPLOYED_AUDIT_ANCHOR
#
# BLOCKCHAIN_OWNER_ADDRESS=0xCOLD_WALLET_OR_MULTISIG
# Do not put owner private key on backend production hosts.
# BLOCKCHAIN_OWNER_PRIVATE_KEY=
#
# BLOCKCHAIN_RELAYER_ADDRESS=0xBACKEND_RELAYER_ADDRESS
# BLOCKCHAIN_RELAYER_PRIVATE_KEY=0xBACKEND_RELAYER_PRIVATE_KEY
#
# VITE_IDENTITY_REGISTRY_ADDRESS=0xDEPLOYED_IDENTITY_REGISTRY
# VITE_NETWORK_RPC_URL=https://your-production-rpc.example
# VITE_CHAIN_ID=<PRODUCTION_CHAIN_ID>
#
# Example chain IDs:
# - Sepolia: 11155111
# - Polygon: 137
# - Base: 8453
# - Arbitrum One: 42161
# - Ethereum mainnet: 1
