# =============================================================================
# KLTN Blockchain environment template
#
# Copy this file inside the blockchain folder:
#   cp .env.example .env
#
# Local deploy flow:
#   npm install
#   npm run node
#   npm run deploy:local
#
# Custom RPC deploy flow:
#   set NETWORK_RPC_URL=https://...
#   set PRIVATE_KEY=0x...
#   npm run deploy:custom
#
# After deploy, copy the printed contract addresses back into this file.
# Root .env intentionally does not contain blockchain keys anymore.
# =============================================================================

# -----------------------------------------------------------------------------
# Hardhat/deployer network
# -----------------------------------------------------------------------------
NETWORK_RPC_URL=http://127.0.0.1:8545

# Private key used by Hardhat when deploying to the `custom` network.
# Local default below is Hardhat account #0. Do not use it outside local dev.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# -----------------------------------------------------------------------------
# Backend blockchain runtime
# -----------------------------------------------------------------------------
# Native backend uses this value directly.
# Docker Compose overrides it to http://host.docker.internal:8545 because the
# Hardhat node is run on the host, not as a compose service.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Contract addresses. The defaults are from a fresh local Hardhat deploy with
# scripts/deploy.js. Replace these whenever you redeploy.
IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
FACE_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
AUDIT_ANCHOR_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# -----------------------------------------------------------------------------
# Owner vs relayer signer model
# -----------------------------------------------------------------------------
# Owner/root governance:
# - Can authorize/revoke Admin wallets.
# - Can add/remove backend relayers.
# - Can transfer ownership.
# - Local/dev may keep this key here. Production should move ownership to a
#   cold wallet or multisig and should not keep the owner key on the backend.
BLOCKCHAIN_OWNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
BLOCKCHAIN_OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Backend hot wallet:
# - Signs routine writes such as AuditAnchor.commitRoot() and FaceRegistry hashes.
# - If lost/leaked, the owner removes this relayer and authorizes a new one.
BLOCKCHAIN_RELAYER_ADDRESS=0x70997970c51812dc3a010c7d01b50e0d17dc79c8
BLOCKCHAIN_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f094538f9d0e86e9f47ff2bb83cb3e61a69062e

# Deprecated compatibility fallback. Prefer the explicit owner/relayer keys.
# SUPER_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Frontend wallet verification config
# -----------------------------------------------------------------------------
VITE_IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_NETWORK_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337
