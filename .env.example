# ============================================================
# KLTN Root environment - Docker Compose Config
# Only contains variables needed by docker-compose.yml / docker-compose.prod.yml.
# App-specific runtime variables are in backend/.env and frontend/.env.
# ============================================================

# Local/dev defaults. For VPS production, change these values in the real .env file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zkp_identity

# Production deploy images. These are normally overridden by GitHub Actions.
BACKEND_IMAGE=ghcr.io/your-github-user/your-repository-backend:latest
FRONTEND_IMAGE=ghcr.io/your-github-user/your-repository-frontend:latest
APP_VERSION=local
