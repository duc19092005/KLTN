# =============================================================================
# KLTN Hospital Management System — environment template
#
# 1. Copy this file:           cp .env.example .env
# 2. (Optional) For native run: cp .env backend/.env
#    — Used when starting backend without Docker (npm run start:dev).
#    — Keep both files identical; docker-compose reads root `.env` only.
# 3. Generate secrets where indicated. Real secrets MUST NOT be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL connection
# -----------------------------------------------------------------------------
# When running in Docker the host is `db` (compose service name).
# When running backend natively, replace with `localhost`.
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/zkp_identity?schema=public"

# Optional overrides for the bundled Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zkp_identity

# -----------------------------------------------------------------------------
# AUTH — JWT, cookies, session
# -----------------------------------------------------------------------------
# Generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
JWT_EXPIRATION=1h
JWT_COOKIE_MAX_AGE_MS=3600000

# Cookie behavior. AUTH_COOKIE_SECURE auto-enables in production.
# AUTH_COOKIE_SAME_SITE: "lax" | "none" | "strict"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Wallet sign-in challenge string prefix (defaults to "KLTN Admin Auth")
AUTH_MESSAGE_DOMAIN="KLTN Admin Auth"

# Optional override for the bootstrap-admin secret. If unset, falls back to
# BLOCKCHAIN_OWNER_PRIVATE_KEY, then legacy SUPER_ADMIN_PRIVATE_KEY.
# BOOTSTRAP_ADMIN_SECRET=

# -----------------------------------------------------------------------------
# ENCRYPTION — AES-256 key (64 hex chars = 32 bytes)
# Used to encrypt face descriptors, AI provider keys, etc. in the DB.
# Generate:  openssl rand -hex 32
# WARNING: rotating this makes existing encrypted data unrecoverable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# -----------------------------------------------------------------------------
# AUDIT — tamper-evidence pepper
# Salt for the on-disk audit hash chain (backup-ledger.jsonl & similar).
# Must NEVER be stored in the database. The break-glass viewer needs this
# value to verify entryHash when auditing offline.
# Generate:  openssl rand -hex 32
# -----------------------------------------------------------------------------
AUDIT_PEPPER=CHANGE_ME_64_HEX_CHARS

# Blockchain Audit V2 cryptographic keys.
# AUDIT_HASH_KEY is an HMAC secret for before/after/diff/data hashes; use at least 32 chars.
# AUDIT_ENCRYPTION_KEY is AES-256-GCM key material; must be 64 hex chars = 32 bytes.
# AUDIT_ENCRYPTION_KEY_ID is a non-secret rotation label stored with each encrypted row.
# Generate examples:
#   openssl rand -base64 48   # AUDIT_HASH_KEY
#   openssl rand -hex 32      # AUDIT_ENCRYPTION_KEY
AUDIT_HASH_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
AUDIT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AUDIT_ENCRYPTION_KEY_ID=local-dev-audit-key-v1
# Local dev/CI only. Never enable in production.
ALLOW_INSECURE_AUDIT_CRYPTO=false

# -----------------------------------------------------------------------------
# BLOCKCHAIN — Hardhat RPC + smart-contract addresses
# Defaults below are the deterministic addresses Hardhat assigns when running
# `scripts/deploy.js` then `scripts/deploy-audit.js` against a fresh local
# node. Replace if you redeploy on a different network.
# -----------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://blockchain:8545

IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
FACE_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
AUDIT_ANCHOR_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
# AuditAnchor uses the canonical MERKLE_SHA256_BYTES32_V2 backend/contract semantics.
# For production, deploy the same AuditAnchor.sol and change only BLOCKCHAIN_RPC_URL + AUDIT_ANCHOR_ADDRESS.

# These three are reserved for upcoming registries. Safe to leave unset.
DEPARTMENT_REGISTRY_ADDRESS=
STAFF_REGISTRY_ADDRESS=
AI_MODEL_REGISTRY_ADDRESS=

# -----------------------------------------------------------------------------
# BLOCKCHAIN SIGNERS — Owner vs Relayer
#
# IMPORTANT MODEL:
# - BLOCKCHAIN_OWNER_PRIVATE_KEY is the root governance key. It can authorize
#   Admin wallets and add/remove backend relayers. Keeping this in env is a
#   development/convenience compromise. For production, move ownership to a
#   cold wallet or multisig and do not store the owner key on the backend host.
# - BLOCKCHAIN_RELAYER_PRIVATE_KEY is the backend hot wallet. It signs routine
#   operational writes such as AuditAnchor.commitRoot() and FaceRegistry hashes.
#   If this key is lost or leaked, the owner can remove it and add a new relayer.
# - Admin wallets are human identity/recovery keys. They sign login/step-up/
#   restore challenges; they do not pay gas for routine audit transactions.
#
# Local Hardhat defaults:
#   owner   = account #0 (also deployer)
#   relayer = account #1
# NEVER commit real production keys. Keep real values in secret storage.
# -----------------------------------------------------------------------------
BLOCKCHAIN_OWNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
BLOCKCHAIN_OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

BLOCKCHAIN_RELAYER_ADDRESS=0x70997970c51812dc3a010c7d01b50e0d17dc79c8
BLOCKCHAIN_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f094538f9d0e86e9f47ff2bb83cb3e61a69062e

# Deprecated backward-compatibility fallback. Prefer the two explicit keys above.
# SUPER_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# FACE AUTH — biometric matching
# face-api 128D descriptor uses Euclidean distance.
# Lower = stricter. Recommended 0.40-0.45 for a clinical system.
# Backend hard-caps this at 0.5 regardless of the value set here.
# -----------------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.45

# -----------------------------------------------------------------------------
# STEP-UP SESSIONS — biometric "sudo mode" timing
# All values in milliseconds.
# -----------------------------------------------------------------------------
STEPUP_TTL_MS=180000             # one-shot token TTL (3 min)
STEPUP_SESSION_IDLE_MS=600000    # session idle timeout (10 min)
STEPUP_SESSION_ABSOLUTE_MS=1800000  # session hard cap (30 min)

# -----------------------------------------------------------------------------
# BACKUP — DB dump scheduling & paths
# -----------------------------------------------------------------------------
BACKUP_CRON_ENABLED=true
BACKUP_CRON_HOUR=2                  # nightly 02:00
# BACKUP_DIR=/app/storage/backups   # default below cwd/storage/backups
# PG_DUMP_BIN=pg_dump               # absolute path if non-default
# BACKUP_LEDGER_PATH=/app/storage/backup-ledger.jsonl

# -----------------------------------------------------------------------------
# CLOUDINARY — medical media storage (X-rays, lab files, avatars)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# SERVER — runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# TELEGRAM ALERTS & ADMIN CONTACT (optional)
# Used by the alert pipeline to notify on tampering / restore events.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PHONE_NUMBER=
