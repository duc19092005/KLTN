# ============================================================
# DATABASE - PostgreSQL
# ============================================================
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/zkp_identity?schema=public"

# ============================================================
# JWT - Token signing secret (min 32 chars). Generate a random value.
#   openssl rand -base64 48
# ============================================================
JWT_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS

# ============================================================
# ENCRYPTION - AES-256 key (64 hex chars = 32 bytes)
# Used to encrypt ZKP secrets and face descriptors in the DB.
#   openssl rand -hex 32
# WARNING: changing this makes existing encrypted data (faceEmbedding,
# mfaSecret) unrecoverable. Plan a re-enrollment if rotating.
# ============================================================
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ============================================================
# BLOCKCHAIN - Smart contract addresses (after deploy)
# ============================================================
IDENTITY_REGISTRY_ADDRESS=
AI_MODEL_REGISTRY_ADDRESS=
DB_BACKUP_REGISTRY_ADDRESS=
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# ============================================================
# SUPER ADMIN - Relayer private key. NEVER COMMIT A REAL KEY.
# For local dev only you may use a Hardhat test account key.
# ============================================================
SUPER_ADMIN_PRIVATE_KEY=CHANGE_ME_DEV_PRIVATE_KEY

# ============================================================
# FACE AUTH - biometric matching
# face-api 128D descriptor uses Euclidean distance.
# Lower = stricter. Recommended 0.40-0.45 for a clinical system.
# Backend hard-caps this at 0.5 regardless of the value set here.
# ============================================================
FACE_MATCH_THRESHOLD=0.45

# ============================================================
# CLOUDINARY - media storage
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
