# =============================================================================
# KLTN Hospital Management System - root environment template
#
# This root template is kept only as a legacy/reference checklist.
# Runtime env is now folder-scoped:
#   backend/.env      -> backend runtime
#   frontend/.env     -> frontend VITE_* public config
#   blockchain/.env   -> blockchain deploy/governance config
#
# Docker Compose reads backend/.env and frontend/.env directly.
# Real secrets MUST NOT be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL connection
# -----------------------------------------------------------------------------
# Docker backend uses the compose DATABASE_URL override with host `db`.
# Native backend should use localhost instead of db.
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/zkp_identity?schema=public"

# Optional overrides for the bundled Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zkp_identity

# -----------------------------------------------------------------------------
# AUTH - JWT, cookies, session
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
JWT_EXPIRATION=1h
JWT_COOKIE_MAX_AGE_MS=3600000

# Cookie behavior. AUTH_COOKIE_SECURE auto-enables in production.
# AUTH_COOKIE_SAME_SITE: "lax" | "none" | "strict"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Wallet sign-in challenge string prefix.
AUTH_MESSAGE_DOMAIN="KLTN Admin Auth"

# Optional backend bootstrap override. Keep this in backend/.env if needed.
# BOOTSTRAP_ADMIN_SECRET=

# -----------------------------------------------------------------------------
# ENCRYPTION - AES-256 key (64 hex chars = 32 bytes)
# Used to encrypt face descriptors, AI provider keys, etc. in the DB.
# Generate: openssl rand -hex 32
# WARNING: rotating this makes existing encrypted data unrecoverable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# -----------------------------------------------------------------------------
# AUDIT - tamper-evidence pepper and Audit V2 crypto
# -----------------------------------------------------------------------------
# AUDIT_PEPPER salts local audit hash chains. It must never be stored in DB.
# Generate: openssl rand -hex 32
AUDIT_PEPPER=CHANGE_ME_64_HEX_CHARS

# AUDIT_HASH_KEY is an HMAC secret; use at least 32 chars.
# AUDIT_ENCRYPTION_KEY is AES-256-GCM key material; 64 hex chars = 32 bytes.
# AUDIT_ENCRYPTION_KEY_ID is a non-secret rotation label stored with each row.
# Generate:
#   openssl rand -base64 48   # AUDIT_HASH_KEY
#   openssl rand -hex 32      # AUDIT_ENCRYPTION_KEY
AUDIT_HASH_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
AUDIT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AUDIT_ENCRYPTION_KEY_ID=local-dev-audit-key-v1

# Local dev/CI only. Never enable in production.
ALLOW_INSECURE_AUDIT_CRYPTO=false

# -----------------------------------------------------------------------------
# BLOCKCHAIN CONFIG
# -----------------------------------------------------------------------------
# Blockchain config is intentionally not stored in root env anymore.
# Use:
#   backend/.env      for backend blockchain runtime RPC/contract/relayer values
#   frontend/.env     for VITE_* public wallet values
#   blockchain/.env   for deploy/governance values

# -----------------------------------------------------------------------------
# FACE AUTH - biometric matching
# -----------------------------------------------------------------------------
# face-api 128D descriptor uses Euclidean distance.
# Lower = stricter. Recommended 0.40-0.45 for a clinical system.
# Backend hard-caps this at 0.5 regardless of the value set here.
FACE_MATCH_THRESHOLD=0.45

# -----------------------------------------------------------------------------
# STEP-UP SESSIONS - biometric "sudo mode" timing
# -----------------------------------------------------------------------------
# All values in milliseconds.
STEPUP_TTL_MS=180000
STEPUP_SESSION_IDLE_MS=600000
STEPUP_SESSION_ABSOLUTE_MS=1800000

# -----------------------------------------------------------------------------
# BACKUP - DB dump scheduling and paths
# -----------------------------------------------------------------------------
BACKUP_CRON_ENABLED=true
BACKUP_CRON_HOUR=2
# BACKUP_DIR=/app/storage/backups
# PG_DUMP_BIN=pg_dump
# BACKUP_LEDGER_PATH=/app/storage/backup-ledger.jsonl

# -----------------------------------------------------------------------------
# AWS S3 - private medical file storage (results, PDFs, diagnostic images)
# -----------------------------------------------------------------------------
# Keep bucket private and enable Block Public Access. S3 stores medical blobs;
# PostgreSQL stores RBAC metadata/objectKey/sha256/etag; blockchain anchors only
# sanitized audit hashes/Merkle roots, never PII, PDFs, images, S3 URLs or keys.
# Backend returns short-lived pre-signed URLs only after RBAC checks.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
AWS_S3_PRESIGNED_URL_TTL_SECONDS=300
AWS_S3_KMS_KEY_ID=

# Local/dev only. Production should prefer IAM Role / workload identity and
# leave static AWS keys unset on the host.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary is used for non-sensitive staff/doctor avatars only.
# Medical result files do not use Cloudinary for new uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# SERVER - runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# TELEGRAM ALERTS AND ADMIN CONTACT (optional)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PHONE_NUMBER=
