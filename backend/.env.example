# ============================================================
# KLTN Backend environment
# Backend owns this file. Do not load frontend/.env or blockchain/.env here.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
JWT_EXPIRATION=1h
JWT_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_MESSAGE_DOMAIN="KLTN Admin Auth"

# Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/zkp_identity?schema=public"

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Backend blockchain runtime only.
# Deploy owner/deployer config belongs in ../blockchain/.env.
BLOCKCHAIN_RPC_URL=https://your-production-rpc.example
IDENTITY_REGISTRY_ADDRESS=0xDEPLOYED_IDENTITY_REGISTRY
FACE_REGISTRY_ADDRESS=0xDEPLOYED_FACE_REGISTRY
AUDIT_ANCHOR_ADDRESS=0xDEPLOYED_AUDIT_ANCHOR
BLOCKCHAIN_RELAYER_ADDRESS=0xBACKEND_RELAYER_ADDRESS
BLOCKCHAIN_RELAYER_PRIVATE_KEY=0xBACKEND_RELAYER_PRIVATE_KEY

# Face auth / step-up
FACE_MATCH_THRESHOLD=0.45
STEPUP_TTL_MS=180000
STEPUP_SESSION_IDLE_MS=600000
STEPUP_SESSION_ABSOLUTE_MS=1800000

# Encryption / audit crypto
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AUDIT_PEPPER=CHANGE_ME_64_HEX_CHARS
AUDIT_HASH_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
AUDIT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AUDIT_ENCRYPTION_KEY_ID=local-dev-audit-key-v1
ALLOW_INSECURE_AUDIT_CRYPTO=false

# Audit batching and encrypted IPFS recovery artifacts
AUDIT_BATCH_INTERVAL_MS=30000
AUDIT_BATCH_MAX_LEAVES=500
IPFS_API_URL=http://localhost:5001
IPFS_API_AUTHORIZATION=
IPFS_GATEWAY_URL=
IPFS_GATEWAY_AUTHORIZATION=
IPFS_SECONDARY_API_URL=
IPFS_SECONDARY_API_AUTHORIZATION=
AUDIT_RECOVERY_MAX_ARTIFACT_BYTES=26214400
# local is development-only; production must use vault
AUDIT_RECOVERY_KEY_PROVIDER=local
AUDIT_RECOVERY_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
AUDIT_RECOVERY_ENCRYPTION_KEY_ID=audit-recovery-local-v1
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit
VAULT_AUDIT_TRANSIT_KEY=kltn-audit-recovery

# Kafka durable audit journal (Docker host uses localhost:9094)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=kltn-audit
KAFKA_AUDIT_GROUP_ID=kltn-audit-projector-v1
KAFKA_AUDIT_TIER_A_TOPIC=audit.events.tier-a
KAFKA_AUDIT_TIER_B_TOPIC=audit.events.tier-b
KAFKA_AUDIT_RETENTION_MS=1209600000
KAFKA_AUDIT_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_OUTBOX_POLL_MS=2000

# AWS S3 medical storage
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
AWS_S3_PRESIGNED_URL_TTL_SECONDS=300
AWS_S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PHONE_NUMBER=

# Patient OTP SMS via eSMS
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_SMS_TYPE=2
ESMS_BRANDNAME=
