generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  LAB_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DepartmentType {
  ADMINISTRATIVE
  CLINICAL
  LABORATORY
  IMAGING
  PHARMACY
  OTHER
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                String     @id @default(uuid())
  username          String     @unique
  email             String     @unique
  passwordHash      String?
  role              UserRole
  status            UserStatus @default(PENDING)
  firstLogin        Boolean    @default(true)
  registrationStep  Int        @default(1)
  tokenVersion      Int        @default(0)
  inviteToken       String?    @unique
  inviteTokenExpiry DateTime?
  faceEmbedding     String?
  faceHash          String?

  // Biometric metadata
  faceModelVersion  String?
  faceEnrolledAt    DateTime?
  faceSampleCount   Int?

  // Biometric anti-replay challenge (single-use nonce)
  faceChallenge          String?
  faceChallengeExpiresAt DateTime?

  // Brute-force lockout
  failedFaceAttempts Int       @default(0)
  faceLockedUntil    DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  staffProfile      StaffProfile?
  adminProfile      AdminProfile?
  performedResults  MedicalResult[]

  @@index([role])
  @@index([status])
}

model Department {
  id             String   @id @default(uuid())
  departmentCode String   @unique
  name           String   @unique
  floor            String?
  status           OperationalStatus @default(ACTIVE)
  type             DepartmentType @default(CLINICAL)
  canReceiveOrders Boolean        @default(false)
  description      String?
  managerId        String?        @unique

  manager        StaffProfile?  @relation("DepartmentManager", fields: [managerId], references: [id])
  staffs         StaffProfile[] @relation("DepartmentStaffs")
  medicalOrders  MedicalOrder[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([canReceiveOrders])
}

model StaffProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId   String?
  department     Department? @relation("DepartmentStaffs", fields: [departmentId], references: [id])

  fullName       String
  phone          String
  gender         String
  citizenId      String  @unique
  birthDate      DateTime
  address        String?
  avatarUrl      String
  employeeCode   String  @unique
  position       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedDepartment Department? @relation("DepartmentManager")
  doctorProfile     DoctorProfile?

  @@index([departmentId])
  @@index([fullName])
}

model DoctorProfile {
  id              String       @id @default(uuid())

  staffProfileId  String       @unique
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  specialty       String
  licenseNumber   String       @unique
  qualification   String
  yearsExperience Int?

  clinicalRoom    ClinicalRoom? @relation("RoomDoctor")
  visits          Visit[]
  aiQualities     AiQuality[]
  medicalOrders   MedicalOrder[]
  reviewedAiDiagnoses AiDiagnosis[]
  medicalConclusions  MedicalConclusion[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([specialty])
}

enum VisitStatus {
  WAITING
  IN_PROGRESS
  WAITING_TEST_RESULT
  WAITING_CONCLUSION
  COMPLETED
  CANCELLED
}

model Patient {
  id               String   @id @default(uuid())
  patientCode      String   @unique
  fullName         String
  gender           String
  birthDate        DateTime
  citizenId        String?  @unique
  phone            String?
  address          String?
  insuranceNumber  String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visits           Visit[]
  aiDiagnoses      AiDiagnosis[]
  medicalOrders    MedicalOrder[]

  @@index([fullName])
  @@index([citizenId])
  @@index([phone])
}

model AdminProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserName  String   @unique
  walletAddress  String?  @unique
  nonce          String?
  nonceExpiresAt DateTime?
  noncePurpose   String?
  mfaSecret      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletAddress])
  @@index([noncePurpose, nonceExpiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
}

model ClinicalRoom {
  id                String          @id @default(uuid())

  roomCode          String          @unique
  roomName          String

  doctorId          String?         @unique
  doctor            DoctorProfile?  @relation("RoomDoctor", fields: [doctorId], references: [id])
  visits            Visit[]

  floor             String?
  description       String?

  status            OperationalStatus @default(ACTIVE)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Visit {
  id             String       @id @default(uuid())
  visitCode      String       @unique

  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  clinicalRoomId String
  clinicalRoom   ClinicalRoom @relation(fields: [clinicalRoomId], references: [id])

  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id])

  status         VisitStatus  @default(WAITING)
  checkInAt      DateTime     @default(now())
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  medicalOrders  MedicalOrder[]
  aiDiagnoses    AiDiagnosis[]
  finalConclusion MedicalConclusion?

  @@index([patientId])
  @@index([doctorId])
  @@index([clinicalRoomId])
  @@index([status])
}

model MedicalOrder {
  id                String             @id @default(uuid())
  orderCode         String             @unique

  visitId           String
  visit             Visit              @relation(fields: [visitId], references: [id])

  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id])

  doctorId          String
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])

  targetDepartmentId String?
  targetDepartment   Department?       @relation(fields: [targetDepartmentId], references: [id])

  orderType         String
  priority          String             @default("NORMAL")
  clinicalNote      String?
  status            MedicalOrderStatus @default(ORDERED)
  orderedAt         DateTime           @default(now())
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  results           MedicalResult[]

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetDepartmentId])
  @@index([status])
}

model MedicalResult {
  id              String       @id @default(uuid())
  resultCode      String       @unique

  orderId         String
  order           MedicalOrder @relation(fields: [orderId], references: [id])

  performedById   String?
  performedBy     User?        @relation(fields: [performedById], references: [id])

  note            String?
  returnedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  files           MedicalResultFile[]

  @@index([orderId])
  @@index([performedById])
}

model MedicalResultFile {
  id             String        @id @default(uuid())
  resultId       String
  result         MedicalResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  fileName       String
  originalName   String
  mimeType       String
  size           Int
  url            String

  createdAt      DateTime      @default(now())

  @@index([resultId])
}

enum MedicalOrderStatus {
  ORDERED
  IN_PROGRESS
  RESULT_READY
  CANCELLED
}

model AiModelRegistry {
  id                   String   @id @default(uuid())
  modelId              String   @unique @default(uuid())
  modelName            String
  modelVersion         String
  recommendedSpecialty String?

  ipHashEncrypted      String
  ipHashPlain          String?
  apiEndpoint          String?
  provider             String?
  isActiveOnChain      Boolean  @default(false)

  description          String?
  createdBy            String
  type                 String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  diagnoses            AiDiagnosis[]
  aiQualities          AiQuality[]

  @@index([modelId])
  @@index([isActiveOnChain])
  @@index([type])
  @@index([provider])
}

model AiDiagnosis {
  id           String          @id @default(uuid())
  aiModelId    String
  aiModel      AiModelRegistry @relation(fields: [aiModelId], references: [id])

  patientId    String?
  patient      Patient?        @relation(fields: [patientId], references: [id])
  visitId      String?
  visit        Visit?          @relation(fields: [visitId], references: [id])

  prompt       String?
  result       String?
  confidence   Float?
  status       String          @default("AI_SUGGESTED")
  reviewedByDoctorId String?
  reviewedByDoctor   DoctorProfile? @relation(fields: [reviewedByDoctorId], references: [id])
  doctorFeedback String?
  conclusions    MedicalConclusion[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([aiModelId])
  @@index([patientId])
  @@index([visitId])
  @@index([reviewedByDoctorId])
}

model MedicalConclusion {
  id              String        @id @default(uuid())
  visitId         String        @unique
  visit           Visit         @relation(fields: [visitId], references: [id])

  doctorId        String
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id])

  aiDiagnosisId   String?
  aiDiagnosis     AiDiagnosis?  @relation(fields: [aiDiagnosisId], references: [id])

  finalDiagnosis  String
  treatmentPlan   String?
  prescription    String?
  followUpNote    String?
  doctorNote      String?
  concludedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([doctorId])
  @@index([aiDiagnosisId])
}

model AiQuality {
  id                         String          @id @default(uuid())
  doctorId                   String
  doctor                     DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  aiModelId                  String
  aiModel                    AiModelRegistry @relation(fields: [aiModelId], references: [id])

  doctorConclusionAboutModel String
  trustablePercent           Float

  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([doctorId])
  @@index([aiModelId])
}
