generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  LAB_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id                String     @id @default(uuid())
  username          String     @unique
  email             String     @unique
  passwordHash      String?
  role              UserRole
  status            UserStatus @default(PENDING)
  firstLogin        Boolean    @default(true)
  registrationStep  Int        @default(1)
  tokenVersion      Int        @default(0)
  inviteToken       String?    @unique
  inviteTokenExpiry DateTime?
  faceEmbedding     String?
  faceHash          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  staffProfile      StaffProfile?
  adminProfile      AdminProfile?

  @@index([role])
  @@index([status])
}

model Department {
  id             String   @id @default(uuid())
  departmentCode String   @unique
  name           String   @unique
  floor          String?
  status         String   @default("ACTIVE")
  description    String?
  managerId      String?  @unique

  manager        StaffProfile?  @relation("DepartmentManager", fields: [managerId], references: [id])
  staffs         StaffProfile[] @relation("DepartmentStaffs")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model StaffProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId   String?
  department     Department? @relation("DepartmentStaffs", fields: [departmentId], references: [id])

  fullName       String
  phone          String
  gender         String
  citizenId      String  @unique
  birthDate      DateTime
  address        String?
  avatarUrl      String
  employeeCode   String  @unique
  position       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedDepartment Department? @relation("DepartmentManager")
  doctorProfile     DoctorProfile?

  @@index([departmentId])
  @@index([fullName])
}

model DoctorProfile {
  id              String       @id @default(uuid())

  staffProfileId  String       @unique
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  specialty       String
  licenseNumber   String       @unique
  qualification   String
  yearsExperience Int?

  clinicalRoom    ClinicalRoom? @relation("RoomDoctor")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([specialty])
}

model AdminProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserName  String   @unique
  walletAddress  String?  @unique
  nonce          String?
  nonceExpiresAt DateTime?
  noncePurpose   String?
  mfaSecret      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletAddress])
  @@index([noncePurpose, nonceExpiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
}

model ClinicalRoom {
  id                String          @id @default(uuid())

  roomCode          String          @unique
  roomName          String

  doctorId          String?         @unique
  doctor            DoctorProfile?  @relation("RoomDoctor", fields: [doctorId], references: [id])

  floor             String?
  description       String?

  status            String          @default("ACTIVE")

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
