generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  LAB_MANAGER
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum OtpPurpose {
  PATIENT_LOGIN
}

enum PatientRelationship {
  SELF
  CHILD
  PARENT
  SPOUSE
  GUARDIAN
  OTHER
}

enum PatientAccessStatus {
  ACTIVE
  PENDING
  REVOKED
}

enum DepartmentType {
  ADMINISTRATIVE
  EXAMINATION
  CLINICAL
  LABORATORY
  IMAGING
  PHARMACY
  OTHER
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
}



enum LabSpecialty {
  LABORATORY
  IMAGING
  BOTH
}

enum MedicalSpecialty {
  GENERAL_INTERNAL_MEDICINE
  GENERAL_SURGERY
  PEDIATRICS
  OBSTETRICS_GYNECOLOGY
  CARDIOLOGY
  ENT
  DENTOMAXILLOFACIAL
  OPHTHALMOLOGY
  DERMATOLOGY
  NEUROLOGY
  ORTHOPEDICS
  GASTROENTEROLOGY
  ENDOCRINOLOGY
  ONCOLOGY
  RESPIRATORY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum VisitSource {
  WALK_IN
  APPOINTMENT
}

model User {
  id                String     @id @default(uuid())
  username          String?    @unique
  email             String?    @unique
  phone             String?
  phoneNormalized   String?    @unique
  passwordHash      String?
  role              UserRole
  status            UserStatus @default(PENDING)
  firstLogin        Boolean    @default(true)
  registrationStep  Int        @default(1)
  tokenVersion      Int        @default(0)
  inviteToken       String?    @unique
  inviteTokenExpiry DateTime?
  faceEmbedding     String?
  faceHash          String?

  // Biometric metadata
  faceModelVersion  String?
  faceEnrolledAt    DateTime?
  faceSampleCount   Int?

  // Biometric anti-replay challenge (single-use nonce)
  faceChallenge          String?
  faceChallengeExpiresAt DateTime?

  // Brute-force lockout
  failedFaceAttempts Int       @default(0)
  faceLockedUntil    DateTime?


  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  staffProfile      StaffProfile?
  adminProfile      AdminProfile?
  patientAccesses   PatientAccess[]
  refreshTokens     RefreshToken[]
  performedResults  MedicalResult[]
  stepUpTickets     StepUpTicket[]

  notifications     Notification[]

  @@index([role])
  @@index([status])
  @@index([phone])
}

model Department {
  id             String   @id @default(uuid())
  departmentCode String   @unique
  name           String   @unique
  floor            String?
  status           OperationalStatus @default(ACTIVE)
  type             DepartmentType @default(CLINICAL)
  canReceiveOrders Boolean        @default(false)
  description      String?
  managerId        String?        @unique

  manager        StaffProfile?  @relation("DepartmentManager", fields: [managerId], references: [id])
  staffs         StaffProfile[] @relation("DepartmentStaffs")
  visits         Visit[]
  medicalOrders  MedicalOrder[]
  appointments   Appointment[]

  blockchainLogs BlockchainLogger[]

  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)).
  // Changes are recorded in BlockchainLogger and anchored through AuditAnchor
  // Merkle batches. dataSalt is a per-record random salt.
  hash256        String?
  dataSalt       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([canReceiveOrders])
}

model StaffProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId   String?
  department     Department? @relation("DepartmentStaffs", fields: [departmentId], references: [id])

  fullName       String
  phone          String
  gender         String
  citizenId      String  @unique
  birthDate      DateTime
  address        String?
  avatarUrl      String
  employeeCode   String  @unique
  position       String?
  labSpecialty   LabSpecialty?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  managedDepartment Department? @relation("DepartmentManager")
  doctorProfile     DoctorProfile?
  assignedVisits    Visit[] @relation("VisitAssignedStaff")
  blockchainLogs    BlockchainLogger[]


  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)), mirrored on-chain.
  hash256        String?
  dataSalt       String?

  @@index([departmentId])
  @@index([fullName])
  @@index([labSpecialty])
}

model DoctorProfile {
  id              String       @id @default(uuid())

  staffProfileId  String       @unique
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  specialty       MedicalSpecialty
  licenseNumber   String       @unique
  qualification   String
  yearsExperience Int?

  aiQualities     AiQuality[]
  medicalOrders   MedicalOrder[]
  appointments    Appointment[]
  reviewedAiDiagnoses AiDiagnosis[]
  medicalConclusions  MedicalConclusion[]
  blockchainLogs      BlockchainLogger[]

  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)), mirrored on-chain.
  hash256        String?
  dataSalt       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([specialty])
}

enum VisitStatus {
  WAITING
  IN_PROGRESS
  WAITING_TEST_RESULT
  WAITING_CONCLUSION
  COMPLETED
  CANCELLED
}

model Patient {
  id               String   @id @default(uuid())
  patientCode      String   @unique
  fullName         String
  gender           String
  birthDate        DateTime
  citizenId        String?  @unique
  phone            String?  @map("contactPhone")
  address          String?
  insuranceNumber  String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  linkedAccounts   PatientAccess[]
  visits           Visit[]
  appointments     Appointment[]
  aiDiagnoses      AiDiagnosis[]
  medicalOrders    MedicalOrder[]
  blockchainLogs   BlockchainLogger[]

  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)), mirrored on-chain.
  hash256          String?
  dataSalt         String?

  @@index([fullName])
  @@index([citizenId])
  @@index([phone])
}

model PatientAccess {
  id              String              @id @default(uuid())

  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  relationship    PatientRelationship @default(SELF)
  status          PatientAccessStatus @default(ACTIVE)

  canViewProfile  Boolean             @default(true)
  canViewVisits   Boolean             @default(true)
  canViewResults  Boolean             @default(true)
  canBookVisit    Boolean             @default(false)

  verifiedAt      DateTime?
  verifiedById    String?
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([userId, patientId])
  @@index([userId])
  @@index([patientId])
  @@index([status])
}

model AdminProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserName  String   @unique
  walletAddress  String?  @unique
  nonce          String?
  nonceExpiresAt DateTime?
  noncePurpose   String?
  mfaSecret      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletAddress])
  @@index([noncePurpose, nonceExpiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
}

model Visit {
  id             String       @id @default(uuid())
  visitCode      String       @unique

  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])

  staffId        String?
  staff          StaffProfile? @relation("VisitAssignedStaff", fields: [staffId], references: [id])

  status         VisitStatus  @default(WAITING)
  source         VisitSource  @default(WALK_IN)
  checkInAt      DateTime     @default(now())
  completedAt    DateTime?
  reason         String?
  symptoms       String?
  initialDiagnosis String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  appointment    Appointment?
  medicalOrders  MedicalOrder[]
  aiDiagnoses    AiDiagnosis[]
  finalConclusion MedicalConclusion?

  @@index([patientId])
  @@index([departmentId])
  @@index([staffId])
  @@index([status])
  @@index([source])
}

model Appointment {
  id              String            @id @default(uuid())
  appointmentCode String            @unique

  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])

  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id])

  doctorId        String?
  doctor          DoctorProfile?    @relation(fields: [doctorId], references: [id])

  scheduledAt     DateTime
  reason          String?
  symptoms        String?
  status          AppointmentStatus @default(CONFIRMED)

  qrTokenHash     String            @unique
  qrExpiresAt     DateTime
  checkedInAt     DateTime?

  visitId         String?           @unique
  visit           Visit?            @relation(fields: [visitId], references: [id])

  cancelledAt     DateTime?
  cancelReason    String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([patientId])
  @@index([departmentId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
}

model MedicalOrder {
  id                String             @id @default(uuid())
  orderCode         String             @unique

  visitId           String
  visit             Visit              @relation(fields: [visitId], references: [id])

  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id])

  doctorId          String
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])

  targetDepartmentId String?
  targetDepartment   Department?       @relation(fields: [targetDepartmentId], references: [id])

  orderType         String
  priority          String             @default("NORMAL")
  clinicalNote      String?
  status            MedicalOrderStatus @default(ORDERED)
  orderedAt         DateTime           @default(now())
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  results           MedicalResult[]

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([targetDepartmentId])
  @@index([status])
}

model MedicalResult {
  id              String       @id @default(uuid())
  resultCode      String       @unique

  orderId         String
  order           MedicalOrder @relation(fields: [orderId], references: [id])

  performedById   String?
  performedBy     User?        @relation(fields: [performedById], references: [id])

  note            String?
  returnedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  files           MedicalResultFile[]

  @@index([orderId])
  @@index([performedById])
}

model MedicalResultFile {
  id             String        @id @default(uuid())
  resultId       String
  result         MedicalResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  fileName       String
  originalName   String
  mimeType       String
  size           Int
  url            String?
  storageProvider String      @default("CLOUDINARY")
  bucket         String?
  objectKey      String?
  sha256         String?
  etag           String?

  createdAt      DateTime      @default(now())

  @@index([resultId])
  @@index([storageProvider])
}

enum MedicalOrderStatus {
  ORDERED
  IN_PROGRESS
  RESULT_READY
  CANCELLED
}

model AiModelRegistry {
  id                   String   @id @default(uuid())
  modelId              String   @unique @default(uuid())
  modelName            String
  modelVersion         String
  recommendedSpecialty String?

  ipHashEncrypted      String
  ipHashPlain          String?
  apiEndpoint          String?
  provider             String?
  isActiveOnChain      Boolean  @default(false)

  description          String?
  createdBy            String
  type                 String?
  isDeleted            Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  diagnoses            AiDiagnosis[]
  aiQualities          AiQuality[]
  blockchainLogs       BlockchainLogger[]

  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)), mirrored on-chain.
  hash256              String?
  dataSalt             String?

  @@index([modelId])
  @@index([isActiveOnChain])
  @@index([isDeleted])
  @@index([type])
  @@index([provider])
}

model AiDiagnosis {
  id           String          @id @default(uuid())
  aiModelId    String
  aiModel      AiModelRegistry @relation(fields: [aiModelId], references: [id])

  patientId    String?
  patient      Patient?        @relation(fields: [patientId], references: [id])
  visitId      String?
  visit        Visit?          @relation(fields: [visitId], references: [id])

  prompt       String?
  result       String?
  confidence   Float?
  status       String          @default("AI_SUGGESTED")
  reviewedByDoctorId String?
  reviewedByDoctor   DoctorProfile? @relation(fields: [reviewedByDoctorId], references: [id])
  doctorFeedback String?
  conclusions    MedicalConclusion[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([aiModelId])
  @@index([patientId])
  @@index([visitId])
  @@index([reviewedByDoctorId])
}

model MedicalConclusion {
  id              String        @id @default(uuid())
  visitId         String        @unique
  visit           Visit         @relation(fields: [visitId], references: [id])

  doctorId        String
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id])

  aiDiagnosisId   String?
  aiDiagnosis     AiDiagnosis?  @relation(fields: [aiDiagnosisId], references: [id])

  finalDiagnosis  String
  treatmentPlan   String?
  prescription    String?
  followUpNote    String?
  doctorNote      String?
  concludedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  blockchainLogs  BlockchainLogger[]

  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)), mirrored on-chain.
  hash256         String?
  dataSalt        String?

  @@index([doctorId])
  @@index([aiDiagnosisId])
}

model AiQuality {
  id                         String          @id @default(uuid())
  doctorId                   String
  doctor                     DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  aiModelId                  String
  aiModel                    AiModelRegistry @relation(fields: [aiModelId], references: [id])

  doctorConclusionAboutModel String
  trustablePercent           Float

  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  blockchainLogs             BlockchainLogger[]

  // Tamper-evidence: hash256 = SHA256(pepper + dataSalt + canonical(data)), mirrored on-chain.
  hash256                    String?
  dataSalt                   String?

  @@index([doctorId])
  @@index([aiModelId])
}

/// Centralized, blockchain-backed audit logger shared across services.
/// Each row records one change (CREATE/UPDATE/DELETE) to one audited entity. The integrity
/// hash is mirrored on-chain; foreign keys point to the specific entity the log refers to
/// (exactly one FK is set per row, the rest are null).
model BlockchainLogger {
  id        String   @id @default(uuid())

  // Who performed the change, what action, and on which logical entity
  actorId   String?
  action    String   // CREATE | UPDATE | DELETE
  entity    String   // denormalized label: "Department", "Patient", ...
  entityId  String?  // affected record id (string form) for display + verification
  metadata  Json?

  // Tamper-evidence integrity fields
  dataHash      String?  // V1: SHA256/HMAC over sanitized payload; V2: HMAC over before/after/diff hashes
  dataSalt      String?  // V1 per-entry salt; null for V2 HMAC rows
  beforeJson    Json?    // V1/safe display snapshot before the change (null on CREATE)
  afterJson     Json?    // V1/safe display snapshot after the change (null on DELETE)

  // Blockchain Audit V2 encrypted-diff fields. Raw before/after snapshots are encrypted;
  // hashes are computed from canonical plaintext, never from ciphertext.
  beforeHash        String?
  afterHash         String?
  diffHash          String?
  hashVersion       String?
  beforeEncrypted   Json?
  afterEncrypted    Json?
  encryptionVersion String?
  encryptionKeyId   String?
  diffJson          Json?
  fieldsChanged     Json?

  // On-chain anchoring
  onChainStatus String?  @default("PENDING") // PENDING | ANCHORED | UNANCHORED
  txHash        String?
  blockNumber   Int?

  // Tamper-evident hash-chain + Merkle batch membership.
  // seq is a strictly monotonic sequence assigned by the serialized writer. entryHash links
  // this row to the previous one (prevHash), so altering/deleting any row breaks the chain and
  // is provable. batchId records which Merkle checkpoint anchored this row on-chain (null =
  // not yet anchored). These columns are the only ones the anchoring job may mutate; all
  // content columns are immutable via a DB trigger (see migration).
  seq        Int?    @unique // monotonic sequence number (1, 2, 3, ...)
  prevHash   String?         // entryHash of seq-1; genesis (seq 1) uses 64 zeros
  entryHash  String?         // SHA256(pepper | seq | prevHash | core fields) -- the chain leaf
  batchId    Int?            // Merkle batch that anchored this row; null until anchored

  // Foreign keys to the audited entities (nullable; exactly one set per row)
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id])

  staffProfileId      String?
  staffProfile        StaffProfile?      @relation(fields: [staffProfileId], references: [id])

  doctorProfileId     String?
  doctorProfile       DoctorProfile?     @relation(fields: [doctorProfileId], references: [id])

  patientId           String?
  patient             Patient?           @relation(fields: [patientId], references: [id])

  aiModelRegistryId   String?
  aiModelRegistry     AiModelRegistry?   @relation(fields: [aiModelRegistryId], references: [id])

  medicalConclusionId String?
  medicalConclusion   MedicalConclusion? @relation(fields: [medicalConclusionId], references: [id])

  aiQualityId         String?
  aiQuality           AiQuality?         @relation(fields: [aiQualityId], references: [id])



  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([departmentId])
  @@index([staffProfileId])
  @@index([doctorProfileId])
  @@index([patientId])
  @@index([aiModelRegistryId])
  @@index([medicalConclusionId])
  @@index([aiQualityId])

  @@index([batchId])
  @@index([onChainStatus])
  @@index([hashVersion])
}

/// One committed Merkle checkpoint over a batch of BlockchainLogger entries.
/// The backend gathers all not-yet-anchored logs (ordered by seq), builds a Merkle tree over
/// their entryHashes, and commits ONLY the root on-chain (AuditAnchor.commitRoot). Storing one
/// root per batch keeps gas flat regardless of how many logs the batch contains. A batch row is
/// created PENDING, flipped to ANCHORED once the on-chain tx confirms, or deleted/marked FAILED
/// if the commit fails (the logs then stay unanchored and are retried next cycle).
model AuditBatch {
  id          String    @id @default(uuid())
  batchId     Int       @unique // monotonic, mirrors the on-chain batchId
  merkleRoot  String            // hex SHA256 Merkle root over the batch's entryHashes
  leafCount   Int               // number of logs in the batch
  fromSeq     Int?              // smallest BlockchainLogger.seq in the batch
  toSeq       Int?              // largest BlockchainLogger.seq in the batch
  status      String    @default("PENDING") // PENDING | ANCHORED | FAILED
  algorithmVersion String @default("MERKLE_SHA256_STRING_V1")
  contractVersion  String?
  txHash      String?
  blockNumber Int?
  error       String?
  createdAt   DateTime  @default(now())
  anchoredAt  DateTime?
  recoveredAt DateTime?

  @@index([status])
  @@index([algorithmVersion])
  @@index([createdAt])
}

/// Short-lived, single-use proof that a user re-authenticated with their face immediately
/// before performing a highly sensitive action (e.g. deleting a doctor, committing a blockchain
/// anchor). This is step-up / re-authentication: even though the user already holds a valid
/// session, irreversible or money-touching operations demand a fresh biometric scan at the moment
/// of the action so a hijacked or unattended session cannot trigger them.
///
/// Flow: POST /auth/face-stepup runs the same face match + on-chain integrity gate as login, then
/// mints a ticket scoped to (userId, action, optional resourceId) that expires in minutes. The
/// client replays the ticket via the x-stepup-ticket header on the protected request; FaceStepUpGuard
/// consumes it atomically (usedAt) so it can never be replayed. We store only the SHA256 of the raw
/// token, never the token itself.
model StepUpTicket {
  id         String   @id @default(uuid())
  tokenHash  String   @unique // SHA256(raw ticket token); raw token is returned to client once
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String            // scope, e.g. "DELETE_DOCTOR" | "ANCHOR_BLOCKCHAIN"
  resourceId String?           // optional: binds the ticket to one specific target record
  ip         String?
  expiresAt  DateTime          // typically now + a few minutes
  usedAt     DateTime?         // set on first (and only) consumption
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([expiresAt])
}



model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String   @unique
  deviceId    String?
  deviceName  String?
  ipAddress   String?
  userAgent   String?

  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model OtpVerification {
  id              String     @id @default(uuid())
  phone           String
  phoneNormalized String
  otpHash         String
  purpose         OtpPurpose @default(PATIENT_LOGIN)
  expiresAt       DateTime
  usedAt          DateTime?
  attempts        Int        @default(0)
  maxAttempts     Int        @default(5)
  ipAddress       String?
  userAgent       String?
  requestId       String?    @unique
  sentAt          DateTime?
  blockedUntil    DateTime?
  createdAt       DateTime   @default(now())

  @@index([phoneNormalized, purpose, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}


model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

